{
  "name": "xmlens",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only, MIT-licensed XML development and visualization tool.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "plugins:guard": "node scripts/check-no-third-party-binaries.mjs",
    "check": "npm run lint && npm run typecheck && npm run i18n:check && npm run plugins:guard"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
